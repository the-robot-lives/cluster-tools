#!/usr/bin/env bash
# =============================================================================
# cluster-helm — Helm release status with failure highlighting
#
# Usage:
#   cluster-helm               # all namespaces
#   cluster-helm -n <namespace> # specific namespace
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-$(cd "$SCRIPT_DIR/../../k8-lib" 2>/dev/null && pwd || echo "${HOME}/.local/share/k8-lib")}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"

BOLD=$'\033[1m'
CYAN=$'\033[0;36m'
DIM=$'\033[2m'

NS_FLAG="--all-namespaces"
[[ "${1:-}" == "-n" && -n "${2:-}" ]] && NS_FLAG="-n $2"

echo -e "${BOLD}${CYAN}Helm Releases${NC}  $(date '+%H:%M:%S')\n"

printf "${BOLD}%-12s %-28s %-8s %-10s %-35s %s${NC}\n" \
  "NAMESPACE" "RELEASE" "REV" "STATUS" "CHART" "UPDATED"
echo "--------------------------------------------------------------------------------------------------------------"

helm list $NS_FLAG --output json 2>/dev/null | \
  python3 -c "
import json, sys
releases = json.load(sys.stdin)
for r in sorted(releases, key=lambda x: (x.get('namespace',''), x.get('name',''))):
    ns = r.get('namespace', '?')
    name = r.get('name', '?')
    rev = str(r.get('revision', '?'))
    status = r.get('status', '?')
    chart = r.get('chart', '?')
    updated = r.get('updated', '?')[:19] if r.get('updated') else '?'

    # Color by status
    if status == 'deployed':
        color = '\033[0;32m'  # green
    elif status == 'failed':
        color = '\033[0;31m'  # red
        status += '  <--'
    elif status in ('pending-install', 'pending-upgrade'):
        color = '\033[1;33m'  # yellow
    else:
        color = '\033[0m'

    print(f'{ns:<12s} {name:<28s} {rev:<8s} {color}{status:<10s}\033[0m {chart:<35s} {updated}')
" 2>/dev/null

echo ""
